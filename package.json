{
  "name": "exchange-student-platform",
  "version": "1.0.0",
  "private": true,
  "description": "國際交換生來台生活平台 — International Exchange Student Support Platform",
  "scripts": {
    "dev": "tsx prisma/tools/check.ts && node scripts/prisma-generate.js && next dev",
    "build": "node scripts/prisma-generate.js && next build",
    "start": "tsx prisma/tools/check.ts && next start",
    "lint": "next lint",
    "postinstall": "node scripts/prisma-generate.js",
    "db:generate": "node scripts/prisma-generate.js",
    "db:migrate": "tsx prisma/tools/prismaCli.ts migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:import-life": "tsx prisma/import-life-all.ts",
    "db:import-life-comics": "tsx prisma/import-life-comics.ts",
    "db:import-life-vocabulary": "tsx prisma/import-life-vocabulary.ts",
    "db:audit-life": "tsx prisma/reset-life-chinese.ts --dry-run",
    "db:reset-life-vocabulary": "tsx prisma/reset-life-chinese.ts",
    "db:studio": "tsx prisma/tools/prismaCli.ts studio",
    "db:doctor": "tsx prisma/tools/doctor.ts",
    "db:restore-life": "tsx prisma/tools/restoreLife.ts",
    "calendar:images": "tsx prisma/tools/calendarImages.ts",
    "db:backup": "tsx prisma/tools/backup.ts",
    "db:push": "tsx prisma/tools/prismaCli.ts db push",
    "db:patch-content": "tsx prisma/tools/contentPatch.ts",
    "db:update": "tsx prisma/tools/update.ts",
    "data:init": "tsx prisma/tools/dataInit.ts",
    "db:verify-backup": "tsx prisma/tools/verifyBackups.ts",
    "check:project": "tsx prisma/tools/projectGuard.ts",
    "check:env": "tsx prisma/tools/checkEnv.ts",
    "test:cloudinary": "tsx tests/cloudinary/run.ts",
    "check:cloudinary": "tsx prisma/tools/cloudinaryLiveCheck.ts",
    "audit:uploads": "tsx prisma/tools/uploadsAudit.ts",
    "test:audit": "tsx tests/audit/run.ts",
    "migrate:uploads": "tsx prisma/tools/uploadsMigrate.ts",
    "test:migrate": "tsx tests/migrate/run.ts",
    "db:precheck-pg": "tsx prisma/tools/pgPrecheck.ts",
    "test:pgprecheck": "tsx tests/pgprecheck/run.ts",
    "check:upload-one": "tsx prisma/tools/uploadsCheckOne.ts",
    "test:checkone": "tsx tests/checkone/run.ts",
    "db:migrate-to-pg": "tsx prisma/tools/pgMigrate.ts",
    "test:pgmigrate": "tsx tests/pgmigrate/run.ts",
    "test:pgreader": "tsx tests/pgmigrate/reader.ts",
    "test:schema": "tsx tests/schema/run.ts",
    "test:driveoauth": "tsx tests/driveoauth/run.ts",
    "test:photowall": "tsx --tsconfig tests/photowall/tsconfig.json tests/photowall/run.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.18.0",
    "bcryptjs": "2.4.3",
    "cloudinary": "2.5.1",
    "clsx": "2.1.1",
    "framer-motion": "11.3.19",
    "googleapis": "^140.0.1",
    "lucide-react": "0.408.0",
    "next": "14.2.5",
    "next-auth": "4.24.7",
    "next-themes": "0.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "20.14.13",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "pg": "^8.23.1",
    "postcss": "8.4.40",
    "prisma": "5.18.0",
    "sql.js": "^1.16.0",
    "tailwindcss": "3.4.7",
    "tsx": "^4.23.13",
    "typescript": "5.5.4"
  }
}

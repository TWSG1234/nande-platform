# ── 資料庫與上傳檔案位置（不放在這個檔案裡）─────────────────────────────
# 本機開發：資料庫與上傳圖片放在「程式資料夾以外」的固定資料夾，位置用 `npm run data:init` 一次性設定
# （記在你電腦的使用者家目錄 .nande-platform.json），或用環境變數 NANDE_DATA_DIR 指定。
# 本機模式「不使用」DATABASE_URL；舊版 .env 裡的 DATABASE_URL="file:./dev.db" 可以整行刪除。
#
# 正式上線（Vercel + Neon PostgreSQL）：這些變數只設在 Vercel 的 Environment Variables，不要放進本機 .env.local。
# 詳細說明見 docs/PostgreSQL與雲端儲存遷移指南.md「Vercel 部署」。
#
#   NANDE_DB_MODE=remote
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15   # Neon「pooled」連線字串
#   # DIRECT_URL：網站執行期不需要，Vercel 上建議不要設定（只有用 Prisma CLI 改資料庫結構時才在本機使用）
#
#   # 環境防護（Vercel 必設；Production 與 Preview 各自設定不同的值，且資料庫連線字串也必須不同）
#   NANDE_DB_TARGET=production          # Production 環境填 production；Preview 環境填 preview
#   NANDE_PROD_DB_HOST=ep-xxxx.REGION.aws.neon.tech   # 正式資料庫主機名稱（不含密碼；Production 與 Preview 都要設，Preview 用它確認自己沒連到正式資料庫）
#   # Preview 環境：DATABASE_URL 必須指向「獨立的 Neon Branch」；若主機等於 NANDE_PROD_DB_HOST，網站與 build 會直接拒絕啟動。
#
#   STORAGE_DRIVER=cloudinary           # Vercel 檔案系統唯讀，必須用 Cloudinary（以及下方 CLOUDINARY_*）
#
# 本機開發「不要」設定 NANDE_DB_MODE=remote；備份／診斷／匯入／seed／db push 等維運工具在遠端模式下會被拒絕。
# 產生 Prisma Client 的 schema 由 scripts/prisma-generate.js 自動選擇：Vercel 用 prisma/schema.postgres.prisma，本機用 prisma/schema.prisma（SQLite）。

# ── NextAuth（管理員登入）─────────────────────────────────────────────────
# 這一行不能留空，也不能保持雙引號中間空白，否則管理員登入會一直被擋下來！
# 隨便打一串英數字亂碼就可以，或執行： openssl rand -base64 32
NEXTAUTH_SECRET="請改成一串隨機亂碼-不要留空"
# 開發環境用 http://localhost:3000；正式上線改成你的網域
NEXTAUTH_URL="http://localhost:3000"

# ── 管理員帳號（僅在第一次執行 db:seed 時用來建立第一個管理員帳號）────────
# 之後可以在 /admin 後台自行修改密碼，這兩個值只是「初始帳號」。
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# ── Google Drive（學生投稿照片審核通過後存進 Drive）：管理員個人 Gmail OAuth 2.0 ──
# 已不再使用 Service Account（GOOGLE_CLIENT_EMAIL／GOOGLE_PRIVATE_KEY 不會被讀取，可刪除）。
# 真正的值只放 .env.local 或 Vercel 後台環境變數，不要寫進程式碼、Git 或貼到對話。
# Client Secret 與加密金鑰只在伺服器端使用，不會送到瀏覽器。
GOOGLE_OAUTH_CLIENT_ID=""            # Google Cloud 的 OAuth Web Client ID
GOOGLE_OAUTH_CLIENT_SECRET=""        # 對應的 Client Secret
GOOGLE_TOKEN_ENCRYPTION_KEY=""       # 自訂一串隨機長字串（至少 32 字元）；用來加密存進資料庫的 Refresh Token
GOOGLE_DRIVE_FOLDER_ID=""            # 原本的「南得遇見你_學生投稿」資料夾 ID（沿用）
# 選填；沒填就用 NEXTAUTH_URL + /api/admin/google-drive/callback，必須與 Google Cloud 登記的完全相同
# GOOGLE_OAUTH_REDIRECT_URI="https://nande-platform.vercel.app/api/admin/google-drive/callback"

# ── 圖片儲存：local（預設，固定資料夾）或 cloudinary ─────────────────────────
# 這個檔案只是範本；真正的值請寫在 .env.local（不會進 Git／ZIP），不要貼到對話。
# 切換方式：改 STORAGE_DRIVER 後重新啟動網站即可。資料庫內容不用改（存的都是 /uploads/... 網址）。
# STORAGE_DRIVER=local
# STORAGE_DRIVER=cloudinary
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""        # 只放伺服器端環境變數，絕不能加 NEXT_PUBLIC_ 前綴
# （或改用單一變數：CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"）
# CLOUDINARY_FOLDER="nande-platform"   # 選用：Cloudinary 裡存放本網站圖片的資料夾，預設 nande-platform
# CLOUDINARY_DELETE_MODE="trash"       # 選用：trash（預設，移到 _trash 可找回）／destroy（永久刪除）
# CLOUDINARY_FALLBACK="1"              # 選用：local 模式下，本機找不到的圖片改轉址到 Cloudinary
# CLOUDINARY_DELIVERY_MODE="proxy"    # 選用：proxy（預設，伺服器取圖後回傳，next/image 也能用）／redirect（302 轉址到 Secure URL）
